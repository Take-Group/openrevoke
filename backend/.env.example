TZ=Europe/Warsaw
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/open_revoke
REDIS_URL=redis://redis:6379/0
TEMPORAL_HOST=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=open-revoke
DEBUG=true
SYNC_INTERVAL_HOURS=6
# Write actions: verification reads after a write and the wait for the connection lock.
ACTION_VERIFY_ATTEMPTS=3
ACTION_VERIFY_DELAY_SECONDS=30
ACTION_LOCK_WAIT_SECONDS=600
# Development only: show the "fake" connector (test data). Also on when DEBUG=true.
OPEN_REVOKE_ENABLE_FAKE_CONNECTOR=false

# Development only: buttons on the sign-in pages fill the forms (setup, sign-in,
# registration, password reset) with test values from DEV_PREFILL_* (defaults:
# admin@example.com, password open-revoke-dev-password). Anyone who opens the
# panel sees that password. Leave false for real use.
OPEN_REVOKE_DEV_PREFILL=false
# Fernet key that encrypts connector secrets. Required. Generate it with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# In Docker the value comes from OPEN_REVOKE_SECRET_KEY in the root .env file.
OPEN_REVOKE_SECRET_KEY=
# Browser origins allowed to call the API (JSON list). The origin of PUBLIC_URL is always added.
# CORS_ORIGINS=["http://localhost:18410","http://127.0.0.1:18410"]
# Host names the API answers to; others get 400 (DNS rebinding protection). The host of
# PUBLIC_URL is always added.
# ALLOWED_HOSTS=["localhost","127.0.0.1","[::1]","app","open-revoke-app"]
# Shared browser (service `browser`): CDP via socat, by IP (skills/backend/browser.md).
BROWSER_CDP_HOST=browser
BROWSER_CDP_PORT=9223
# Live view: the API passes noVNC from the browser container (port 6080) to the panel.
# BROWSER_LIVE_PORT=6080
# Panel sign-in (skills/backend/auth.md): address in invite and reset links, session length.
PUBLIC_URL=http://localhost:18410
SESSION_TTL_HOURS=168
