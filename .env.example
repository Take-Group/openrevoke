# Copy to .env before `docker compose up`. Docker Compose reads .env from this
# directory and passes the values to the containers. install.sh writes this file
# itself (secrets generated, time zone from the host). Install guide:
# docs/self-hosting.md.

# Release to run: the image tag of ghcr.io/take-group/open-revoke and
# open-revoke-browser. `open-revoke update` changes it; never `latest`, every
# version may change the database.
OPEN_REVOKE_VERSION=dev

# Password of the bundled PostgreSQL. Required. Only the containers reach the
# database. Generate one with: openssl rand -hex 24
# It is set when the database is created; changing it here later does not
# change the database's password.
POSTGRES_PASSWORD=

# Time zone of the server: logs and container clocks. install.sh copies it from
# the host. Dates in the panel use the organization's zone from the setup.
# TZ=UTC

# Compose project name; change it to run a second installation on the same host.
# COMPOSE_PROJECT_NAME=open-revoke

# The panel asks GitHub once an hour whether a newer stable release exists and
# shows admins a notice. Only GitHub sees the request. false turns it off (for
# servers without internet access).
# OPEN_REVOKE_UPDATE_CHECK=true

# When the first admin finishes the setup, the server sends one anonymous event
# (event name and version) to openrevoke.com. TELEMETRY.md says what is sent.
# false turns it off.
# OPEN_REVOKE_TELEMETRY=true

# The address people open the panel at, e.g. https://revoke.example.com.
# Everything follows it: invite and reset links, "Connect with Google", the secure
# cookie flag and the host names the API answers to. The panel shows a warning
# when it is opened under another address. Google sign-in needs https and a
# public domain here (plain http works only for localhost).
# PUBLIC_URL=http://localhost:18410

# Where the panel listens on the server. 127.0.0.1 keeps it for a reverse proxy
# on the same machine; 0.0.0.0 opens it on every interface (plain http).
# OPEN_REVOKE_BIND=127.0.0.1
# OPEN_REVOKE_PORT=18410

# `docker compose --profile https up -d` adds Caddy, which gets a Let's Encrypt
# certificate for PUBLIC_URL. Needs DNS pointing at the server and ports 80 and
# 443 open to the internet.
# OPEN_REVOKE_HTTP_PORT=80
# OPEN_REVOKE_HTTPS_PORT=443

# "Connect with Google" sends the admin back to
# <base>/api/discovery/google-oauth/callback. Empty: PUBLIC_URL. Set it only
# when PUBLIC_URL cannot be a Google redirect (e.g. http on a LAN name) and an
# SSH tunnel to http://localhost:18410 is used for this one step.
# GOOGLE_OAUTH_REDIRECT_BASE=

# Fernet key that encrypts connector secrets (API tokens, SCIM tokens, Google
# service account JSON). Required: the stack refuses to start without it.
# Generate it with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# or, without Python on the host:
#   openssl rand -base64 32 | tr '+/' '-_'
# Losing this key makes stored connector secrets unreadable. Keep a copy in a
# password manager.
OPEN_REVOKE_SECRET_KEY=

# Development only: adds the "fake" connector (deterministic test accounts on
# example.com) to the catalog, for trying syncs without real credentials.
# Leave false for real use.
OPEN_REVOKE_ENABLE_FAKE_CONNECTOR=false

# Development only: buttons on the sign-in pages fill the forms (setup, sign-in,
# registration, password reset) with test values from DEV_PREFILL_* (defaults:
# admin@example.com, password open-revoke-dev-password). Anyone who opens the
# panel sees that password. Leave false for real use.
OPEN_REVOKE_DEV_PREFILL=false

# Seconds between the reads that verify a write action (default 30). Development
# may use 1 to see a failed verification quickly.
# ACTION_VERIFY_DELAY_SECONDS=30



# Development only: a Google Workspace connection the seeder recreates on every
# `python -m app.db reset`, so a reset does not mean connecting Google again.
# Copy the values of a working connection (client of the Google Cloud project,
# refresh token from "Connect with Google"). All four or none. Never commit them.
# GOOGLE_CLOUD_PROJECT_ID=
# SEED_GOOGLE_ADMIN_EMAIL=
# SEED_GOOGLE_OAUTH_CLIENT_ID=
# SEED_GOOGLE_OAUTH_CLIENT_SECRET=
# SEED_GOOGLE_OAUTH_REFRESH_TOKEN=
